# Server URL
server_url: https://vpn.${DOMAIN}

# Listen address for the Headscale server
listen_addr: 0.0.0.0:8080

# gRPC settings (for CLI communication)
grpc_listen_addr: 0.0.0.0:50443
grpc_allow_insecure: false

# Metrics listen address for Prometheus
metrics_listen_addr: 0.0.0.0:9090

# Database configuration
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true

# Disable TLS - Caddy handles TLS termination
tls_cert_path: ""
tls_key_path: ""

# IP Prefixes for the Tailscale network
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

# DERP configuration - Embedded relay server
# Provides relay for clients that can't establish direct connections
derp:
  server:
    # Enable embedded DERP relay
    enabled: true
    region_id: 999
    region_code: "homelab"
    region_name: "Homelab DERP"
    # Only allow authenticated clients
    verify_clients: true
    # STUN for NAT traversal
    stun_listen_addr: "0.0.0.0:3478"
    # Gateway public IP
    ipv4: ${GATEWAY_PUBLIC_IP}
    automatically_add_embedded_derp_region: true
  # Also use Tailscale's public DERP servers as fallback
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  auto_update_enabled: true
  update_frequency: 24h

# Disable automatic check for updates
disable_check_updates: true

# Ephemeral node inactivity timeout
ephemeral_node_inactivity_timeout: 30m

# Node key expiry - DISABLED
# Once registered, nodes stay connected forever until manually removed
node_key_expiry_disabled: true

# DNS configuration
dns:
  # MagicDNS disabled - nodes won't get automatic hostname.base_domain DNS names
  # Only custom extra_records will be provided
  magic_dns: false

  # Use device's local DNS settings instead of overriding them
  # Headscale will still provide extra_records for split DNS
  override_local_dns: false

  # Extra DNS records
  extra_records:
    - name: vpn.${DOMAIN}
      type: A
      value: ${GATEWAY_PUBLIC_IP}
    - name: ${DOMAIN}
      type: A
      value: ${SERVER_TAILSCALE_IP}
    - name: "*.${DOMAIN}"
      type: A
      value: ${SERVER_TAILSCALE_IP}

# Log settings
log:
  level: info
  format: text

# Unix socket for CLI
unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

# ACL Policy - DISABLED
# When no policy is configured, Headscale allows all traffic by default
# This is suitable for trusted family/personal networks
# To enable ACLs later, set mode to "file" and provide a path
policy:
  mode: ""
  path: ""

# OIDC Configuration - Authentik
# Authorized redirect URI: https://vpn.${DOMAIN}/oidc/callback
oidc:
  issuer: "https://auth.${DOMAIN}/application/o/headscale/"
  client_id: "${HEADSCALE_OIDC_CLIENT_ID}"
  client_secret: "${HEADSCALE_OIDC_CLIENT_SECRET}"
  allowed_users: []
  allowed_domains: []
