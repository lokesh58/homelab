{
	servers {
		metrics
	}
}

vpn.{$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
	reverse_proxy headscale:8080
}

vpn.internal.{$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
	reverse_proxy headplane:3000
}

# Catch-all for undefined subdomains
*.{$DOMAIN}, *.internal.{$DOMAIN}, {$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	respond "Not Found" 404
}
