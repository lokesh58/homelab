################################
# Common
################################
DOMAIN=<domain>

################################
# Caddy (TLS)
################################
# Cloudflare API token with Zone:DNS:Edit permission for your domain
# Create a scoped token at: https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=<cloudflare_api_token>

################################
# Headscale
################################
# VPS public IPv4 address (for embedded DERP relay)
VPS_PUBLIC_IP=<vps_public_ip>

# Google OAuth Client ID
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://vpn.<DOMAIN>/oidc/callback
HEADSCALE_OIDC_CLIENT_ID=<google_oauth_client_id>

# Allowed users (comma-separated email addresses)
# Example: user1@gmail.com,user2@gmail.com
HEADSCALE_OIDC_ALLOWED_USERS=<your_email@gmail.com>

# OIDC client secret is stored in: secrets/oidc_client_secret
# Create the file: echo -n "<your_secret>" > secrets/oidc_client_secret

# NOTE: Additional config options in headscale/config.yaml
# Environment variables with HEADSCALE_ prefix override config.yaml values
