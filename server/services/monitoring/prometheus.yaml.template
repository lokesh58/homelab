# Prometheus Configuration

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  # Traefik metrics (local)
  - job_name: 'traefik'
    static_configs:
      - targets: ['traefik:8082']
    metrics_path: /metrics

  # Caddy metrics (Gateway via Tailscale)
  - job_name: 'caddy'
    static_configs:
      - targets: ['${GATEWAY_TAILSCALE_IP}:2019']
    metrics_path: /metrics

  # Headscale metrics (Gateway via Tailscale)
  - job_name: 'headscale'
    static_configs:
      - targets: ['${GATEWAY_TAILSCALE_IP}:9090']
    metrics_path: /metrics
