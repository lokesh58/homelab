# Prometheus Configuration

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  # Traefik metrics (local)
  - job_name: 'traefik'
    static_configs:
      - targets: ['traefik:8082']
    metrics_path: /metrics

  # Traefik metrics (VPN server via Tailscale)
  - job_name: 'traefik_vpn'
    static_configs:
      - targets: ['${VPN_TAILSCALE_IP}:8082']
    metrics_path: /metrics

  # Headscale metrics (VPN server via Tailscale)
  - job_name: 'headscale'
    static_configs:
      - targets: ['${VPN_TAILSCALE_IP}:9090']
    metrics_path: /metrics

